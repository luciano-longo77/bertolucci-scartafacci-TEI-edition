               <app>
                  <rdg wit="#txt43-c #txt44-c">Come lucciola allor ch’estate volge</rdg>
                  <rdg wit="#txt43-1 #txt43-2 #txt43-3 #txt43-4 #txt44-1 #txt44-2"/>
                  <note type="critical">La poesia è senza titolo</note>
               </app>
               <note type="metrical">La poesia si presenta suddivisa in 3 strofe di quartine, con versi di varia misura.</note>
               <lb/>
            </head>
            
            <lg n="1" type="stanza">
               <lg type="quatrain">
                  <l n="1">Come lucciola allor ch’estate volge<lb/></l>
                  <l n="2">All’ardore di luglio, stanca posa<lb/></l>
                  <l n="3">Sull’erba che la vide errare quando<lb/></l>
                  <l n="4">Più temperate sere il cielo invia,<lb/></l>
               </lg>
            </lg>
            
            <lg n="2" type="stanza">
               <lg type="quatrain">
                  <l n="5">Dov’è caduta luce tramortita<lb/></l>
                  <l n="6">E fioca, e così sola nella notte,<lb/></l>
                  <l n="7">
                     <app>
                        <rdg wit="#txt43-c #txt43-1 #txt43-2 #txt43-3 #txt43-4">L’anima giace</rdg>
                        <rdg wit="#txt44-c #txt44-1 #txt44-2">Così l’anima giace,</rdg>
                     </app>
                     poi che il curvo
                     <app>
                        <rdg wit="#txt44-c #txt44-1 #txt44-2"/>
                        <rdg wit="#txt43-1">pino</rdg>
                        <rdg wit="#txt43-2">
                           <del rend="overstrike" hand="black_ink_1">pino</del></rdg>
                     </app>
                     <lb/>
                  </l>
                  <l n="8">
                     <app>
                        <rdg wit="#txt43-c #txt44-c">Giro degli anni torrido declina</rdg>
                        <rdg wit="#txt44-1 #txt44-2">Giro degli anni a sua fine declina</rdg>
                        <rdg wit="#txt43-1 #txt43-2">degli anni torrido rovina</rdg>
                        <rdg wit="#txt43-3">
                           <add place="margin-left" type="integration" hand="#pen1">Giro</add>
                           <retrace>d</retrace>egli anni torrido <hi rend="underline">rovina</hi></rdg>
                        <rdg wit="#txt43-4">Giro degli anni torrido 
                           <add place="margin-right" type="alternation" hand="#pen1">rovina /</add>
                           <add place="margin-right" type="alternation" hand="#pen1">declina</add>
                           <alt target="#txt43-3 #txt43-4" mode="excl" weights="0.1 0.9"/>
                           <note type="critical">In AuIn43 si rintracciano due interventi di tipo integrativo o aggiuntivo come l’inserimento a latere 
                              del manoscritto di possibili sostituzioni (varianti adiafore). I casi di variante adiafora sono presenti al v. 8, 
                              in cui Bertolucci isola nel margine destro il lemma "declina" e sottolinea nel corpo del testo "rovina"; 
                              al v. 9, con l’aggiunta sempre a latere di "allor consoli" come variante alternativa di "ci consoli allora"; 
                              al v. 10 "tremante" come lemma sostitutivo di trepida, parola inserita nel corpo del testo e sottolineata.</note>
                        </rdg>
                     </app>
                     <lb/>
                  </l>
               </lg>
            </lg>
            
            <lg n="3" type="stanza">
               <lg type="quatrain">
                  <l n="9">
                     <app>
                        <rdg wit="#txt44-1 #txt4-1 #txt43-2">Stellata</rdg>
                        <rdg wit="#txt44-2">
                           <add place="inline_margin" type="integration" hand="#pen1">Una </add> Stellata
                           <note type="critical">Il v. 9 di AuIn44 presenta l'aggiunta di "Una" nel rigo di scrittura. 
                              L'intervento è da considerarsi tardivo (T1), successivo alla redazione del testo (tb0).</note>
                        </rdg>
                        <rdg wit="#txt44-c #txt43-3 #txt43-4">Una stellata</rdg>
                        <rdg wit="#txt43-3">
                           <add place="margin_left" type="integration" hand="#pen1">[Una]</add></rdg>
                        <rdg wit="#txt43-4">
                           <add place="margin-right" type="alternation" hand="#pen1">ci consoli</add>
                           <add place="margin_right" type="alternation" hand="#pen1">[allor consoli]</add>
                           <alt target="#txt43-3 #txt43-4" mode="excl" weights="0.1 0.9"/>
                           <note type="critical">
                              L’aggiunta al v. 9 a latere di "allor consoli" come variante alternativa di "ci consoli allora" 
                              è uno dei tre casi di adiaforia di AuIn43.
                           </note>
                        </rdg>
                     </app> 
                     notte 
                     <app>
                        <rdg wit="txt44-1 txt44-2 txt44-c">allor consoli</rdg>
                        <rdg wit="#txt43-1">mi consoli allora</rdg>
                        <rdg wit="#txt43-2"><add place="inline" type="substition" hand="#pen1" resp="#txt43-2">c</add>
                           <del type="overwritten" hand="#pen1" resp="#txt43-2">m</del>i consoli allora</rdg>
                        <rdg wit="#txt43-3">ci sonsoli allora</rdg>
                        <rdg wit="#txt43-c">notte allor consoli</rdg>
                     </app>
                     <lb/>
                  </l>
                  <l n="10">Nostra  
                     <app>
                        <rdg wit="txt44-1 txt44-2 txt44-c">tremante</rdg>
                        <rdg wit="#txt43-1 #txt43-2">trepida</rdg>
                        <rdg wit="#txt43-3"><hi rend="underline">trepid<retrace>a</retrace></hi></rdg>
                        <rdg wit="#txt43-4">
                           <add place="margin-right" type="alternation" hand="#pen1" >trepida</add>
                           <add place="margin_right" type="alternation" hand="black_ink_1" resp="#txt43-4">tremante</add>
                           <alt target="#txt43-3 #txt43-4" mode="excl" weights="0.1 0.9"/>
                           <note type="critical">
                              Il v. 10 a latere esibisce di "tremante" come variante alternativa di "trepida".</note>
                        </rdg>
                     </app>
                     <app>
                        <rdg wit="txt44-1 txt44-2 txt44-c"> quiete,</rdg>
                        <rdg wit="#txt43-1 #txt43-2"> quiete,</rdg>
                        <rdg wit="#txt43-3"> quiet<retrace>e</retrace>,</rdg>
                        <rdg wit="#txt43-4 #txt43-c"> quiete</rdg>
                     </app>
                     <app>
                        <rdg wit="txt44-1 txt44-2 txt44-c #txt43-1">quale è questa</rdg>
                        <rdg wit="#txt43-2">qual<del rend="overstrike" hand="#pen1" >e</del>
                           <add place="above">'</add>è questa</rdg>
                        <rdg wit="#txt43-3 #txt43-4 #txt43-c"> qual'è questa</rdg>
                     </app>
                     <lb/></l>
                  <l n="11">
                     <app>
                        <rdg wit="txt44-1 txt44-2 txt44-c">Che s’apre dolce </rdg>
                        <rdg wit="#txt43-1">Che apri dolce</rdg>
                        <rdg wit="#txt43-2">Che 
                           <add place="inline" type="integration" hand="black_ink_1">s'</add>apr<del type="overstrike">i</del>
                           <add place="inline" type="integration" hand="black_ink_1">e</add> 
                           dolc<retrace cause="unclear">e</retrace></rdg>
                        <rdg wit="#txt43-3 #txt43-4 #txt43-c">Che s'apre dolce</rdg>
                     </app> 
                     e silente<lb/>
                  </l>
                  <l n="12">Su te, lucciola morente.<lb/></l>
