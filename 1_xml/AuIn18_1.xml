            <div>
                <head rend="center">
                    <app>
                        <rdg wit="#txt-c">Come al mattino</rdg>
                        <rdg wit="#txt-1 #txt-2"/>
                        <note type=" critical">La poesia è senza titolo. Essa è composta da 4 strofe di quartine con rima alternata.</note>                    
                    </app>
                </head>
                <lb/>
                <lg n="1" type="stanza">
                    <lg n="1" type="quatrain">
                        <l n="1">Come al mattino<lb/></l>
                        <l n="2">Ci avvicinavamo al mare<lb/></l>
                        <l n="3">Tu volevi di un fiorellino<lb/></l>
                        <l n="4">I tuoi capelli adornare.<lb/></l>
                    </lg>
                </lg>
                <lg n="2" type="stanza">
                    <lg n="2" type="quatrain">
                        <l n="5">
                            <app>
                                <rdg wit="#txt-c">i viali</rdg>
                                <rdg wit="#txt-1">Per le strade</rdg>
                                <rdg wit="#txt-2">
                                    <del rend="overstrike" hand="#pen1">Per le strade</del>
                                    <add place="above" type="substition" hand="#pen2">i viali</add>
                                </rdg>
                                <note type=" critical">
                                   Il primo intervento correttivo si può individuare al v. 5 in cui il poeta dapprima scrive 
                                   "Per le strade", dopo instaura la variante sovrascritta "i viali". 
                                </note>                    
                            </app>
                            che vanno al mare,<lb/></l>
                        <l n="6">
                            <app>
                                <rdg wit="#txt-c">Quieti,</rdg>
                                <rdg wit="#txt-1">Quiete</rdg>
                                <rdg wit="#txt-2">Quiet
                                    <del rend="overstrike" hand="#pen1">e</del>
                                    <add place="inline" type="substition" hand="#pen2">i,</add>
                                </rdg>
                                <note type=" critical">Il poeta sostituisce la "-e" finale di "Quieti" con la "-i".
                                    Inoltre, nel secondo intervento correttorio modifica il sistema interpuntivo: in questo caso aggiunge una virgola.</note>                    
                            </app>
                            <app>
                                <rdg wit="#txt-c">d'oleandri</rdg>
                                <rdg wit="#txt-1">son gli oleandri</rdg>
                                <rdg wit="#txt-2">
                                    <del rend="overstrike" hand="#pen1">son gli</del>
                                    <add place="above" type="substition" hand="#pen2">d'</add>
                                    oleandri
                                </rdg>
                                <note type=" critical">
                                    Il secondo intervento correttivo si può individuare al v. 6 in cui il poeta sostituisce  
                                    "d'oleandri" con "son gli oleandri", con "d’-" sovrascritta "a son gli".
                                </note>                    
                            </app>
                            <app>
                                <rdg wit="#txt-c">fitti</rdg>
                                <rdg wit="#txt-1">fitti,</rdg>
                                <rdg wit="#txt-2">fitti
                                    <del rend="overstrike" hand="#pen1">,</del>
                                </rdg>
                                <note type=" critical">Nel secondo intervento correttorio il poeta modifica il sistema interpuntivo: in questo caso aggiunge una virgola.</note>                    
                            </app>
                            <lb/>
                        </l>
                        <l n="7">Sempre un fiore dovevo 
                            <app>
                                <rdg wit="#txt-c">rubare.</rdg>
                                <rdg wit="#txt-1">rubare,</rdg>
                                <rdg wit="#txt-2">rubare
                                    <del rend="overstrike" hand="#pen1">,</del>
                                    <add place="inline" type="substition" hand="#pen2">.</add>
                                </rdg>
                                <note type=" critical">
                                    Nel secondo intervento correttorio il poeta modifica il sistema interpuntivo: in questo caso aggiunge un punto sulla cassatura di una virgola.</note>                    
                            </app>
                            <lb/>
                        </l>
                        <l n="8">
                            <app>
                                <rdg wit="#txt-c">E fuggivamo</rdg>
                                <rdg wit="#txt-1">Fuggivamo</rdg>
                                <rdg wit="#txt-2">
                                    <add place="inline" type="integration" hand="#pen2">E</add>
                                    <del rend="overstrike" hand="#pen1">F</del>
                                    <add place="inline" type="substition" hand="#pen2">f</add>uggivamo
                                </rdg>
                                <note type=" critical">
                                    Il v. 7 in una prima stesura era "Fuggivamo felici e zitti", il poeta vi interviene inserendo nella riga 
                                    "E" e sovrascrivendo "f-" minuscola sulla "F-" maiuscola. </note>                    
                            </app>
                             felici e zitti. <lb/></l>
                    </lg>
                </lg>
                <lg n="3" type="stanza">
                    <lg n="3" type="quatrain">
                        <l n="9">Poi fra i                             
                            <app>
                                <rdg wit="#txt-c">capelli,</rdg>
                                <rdg wit="#txt-1">capelli</rdg>
                                <rdg wit="#txt-2">capelli
                                    <add place="inline" type="integration" hand="#pen2">,</add>
                            </rdg>
                            <note type=" critical">
                                Nel secondo intervento correttorio il poeta modifica il sistema interpuntivo: in questo caso aggiunge una virgola. 
                            </note>                    
                        </app> 
                            <app>
                                <rdg wit="#txt-c">sull’orecchio,</rdg>
                                <rdg wit="#txt-1">sull’orecchio</rdg>
                                <rdg wit="#txt-2">sull’orecchio
                                    <add place="inline" type="integration" hand="#pen2">,</add>
                                </rdg>
                                <note type=" critical">Nel secondo intervento correttorio il poeta modifica il sistema interpuntivo: in questo caso aggiunge una virgola.</note>                    
                            </app>
                            <lb/></l>
                        <l n="10">
                            <app>
                                <rdg wit="#txt-c">Camminando,</rdg>
                                <rdg wit="#txt-1">Camminando</rdg>
                                <rdg wit="#txt-2">Camminando
                                    <add place="inline" type="integration" hand="#pen2">,</add>
                                </rdg>
                                <note type=" critical">
                                    Nel secondo intervento correttorio il poeta modifica il sistema interpuntivo: in questo caso aggiunge una virgola.
                                </note>                    
                            </app> 
                            <app>
                                <rdg wit="#txt-c">lo infilavi</rdg>
                                <rdg wit="#txt-1">l'aggiustavi</rdg>
                                <rdg wit="#txt-2">l
                                    <del rend="overstrike" hand="#pen1">'</del>
                                    <add place="inline" type="substition" hand="#pen2">o</add>
                                    <del rend="overstrike" hand="#pen2">aggiuistavi</del>
                                    <add place="inline" type="substition" hand="#pen2">infilavi</add>
                                </rdg>
                                <note type=" critical">Il v. 10 in una prima forma del testo funzionava così: 
                                    "Camminando lo aggiustavi", successivamente Bertolucci cassa "lo aggiustavi" inserendo "infilavi".</note>                    
                            </app>
                            <lb/></l>
                        <l n="11">Senza aiuto di specchio<lb/></l>
                        <l n="12">Così giusto lo posavi.<lb/></l>
                    </lg>
                </lg>
                <lg n="4" type="stanza">
                    <lg n="4" type="quatrain">
                        <l n="13">Preferivi il rosso 
                            <app>
                                <rdg wit="#txt-c #txt-1">e il rosa</rdg>
                                <rdg wit="#txt-2">
                                    <retrace cause="unclear">e</retrace> il r<retrace cause="unclear">o</retrace>sa
                                </rdg>
                                <note type=" critical">La congiunzione e il nome del colore vengono rivergati con lo stesso inchiostro delle correzioni.</note>                    
                            </app>
                            <lb/></l>
                        <l n="14">Che a te, bruna, si conveniva.<lb/></l>
                        <l n="15">Alla sera una dolce cosa<lb/></l>
                        <l n="16">Obliata, si gualciva.<lb/></l>
                    </lg>
                </lg>
                <ab>
                    <date>21 agosto 1935</date>
                </ab>
            </div>
