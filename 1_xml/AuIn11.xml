            <div>
                <head rend="center">Questo è il caro autunno…</head>
                <lb/>
                <note type="metrical">La poesia si presenta in una unica strofa di 15 versi. </note>
                <lg n="1" type="stanza">
                    <l n="1">Questo è il caro autunno.<lb/></l>
                    <l n="2">Una stradetta conosciamo<lb/></l>
                    <l n="3">Da alberi alti nel fondo<lb/></l>
                    <l n="4">Limitata.<lb/></l>
                    <l n="5">A una svolta un’acqua limpida<lb/></l>
                    <l n="6">Fa chinare gli occhi.<lb/></l>
                    <l n="7">Scorre tra folta erba<lb/></l>
                    <l n="8">Invita al riposo.<lb/></l>
                    <l n="9">Così, seduti in silenzio, si stava.<lb/></l>
                    <l n="10">Veniva la sera<lb/></l>
                    <l n="11">Con una sua tonda lucerna<lb/></l>
                    <l n="12">Ad ammonirci di tornare a casa.<lb/></l>
                    <l n="13">Ora la stradetta era più buia<lb/></l>
                    <l n="14">E i baci più fitti,<lb/></l>
                    <l n="15">Fitti e dolci come grappoli d’uva.<lb/></l>
                </lg> 
                <ab>
                    <app>
                        <rdg wit="#txt-1"><hi rend="underline">settembre 1934</hi></rdg>
                        <rdg wit="#txt-c">settembre 1934</rdg>
                    </app>
                    
                </ab>
            </div>
