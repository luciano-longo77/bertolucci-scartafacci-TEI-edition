                <lg type="stanza">
                    <l n="1">O anni lontani, m’assale<lb/></l>
                    <l n="2">il vostro ricordo, come s’alza il vento<lb/></l>
                    <l n="3">all’entrare in un borgo, 
                        <app>
                            <rdg wit="#txt-c">di sera;
