                                </note></rdg>
                            <rdg wit="#txt-1 #txt-2">Non corri a me, ma portata</rdg>
                            <rdg wit="#txt-3">(portata) sempre più lontana dalle raffiche
                                <note type="critical">Bertolucci aggiunge con il lapis "Perché, non portata", 
                                    verso che cassa nuovamente, mantenendo solo il participio (portata), che collega con una freccia al verso successivo</note>
                            </rdg>
                        </app>
                        <lb/></l>
                    
                        <app>
                            <rdg wit="#txt-c"/>
                            <rdg wit="#txt-1 #txt-2"><l n="14">sempre più lontana dalle raffiche</l></rdg>
                            <rdg wit="#txt-3"><l n="14">non smetti il tuo lamento 
                                <del rend="overstrike" hand="#pen2">? </del>
                                <add place="above" type="substition" hand="#pen2" resp="#berty"> .</add>
                            <note type="critical">Variazione di punteggiatura; in luogo del punto interrogativo inserisce un punto fermo</note></l>
                            </rdg>
                        </app>
                        <lb/>
                    
