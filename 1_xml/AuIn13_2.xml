            <div>
                <head><hi rend="underline">Epigramma</hi><lb/></head>
                <lg type="stanza">
                    <l n="1">Come potrei preferire<lb/></l>
                    <l n="2">la notte<lb/></l>
                    <l n="3">Se la 
                        <app>
                            <rdg wit="#txt-c">n
                            </rdg>
                            <rdg wit="#txt-1">N</rdg>
                            <rdg wit="#txt-2">
                                <del rend="overstrike" hand="#pen1">N</del>
                                <add place="superscript" type="substition" hand="#pen1">n</add></rdg>
                        </app>
                        otte 
                        <note type="critical">In "notte" Bertolucci sovr. su "N-" maiuscola la "n-" minuscola.</note>
                        <app>
                            <rdg wit="#txt-c #txt-2">N
                            </rdg>
                            <rdg wit="#txt-1">
                                <del rend="overstrike" hand="#pen1">Pag</del>
                                <add place="superscript" type="substition" hand="#pen1" instant="true">N</add>
                            </rdg>
                        </app> 
                        inetta
                        <note type="critical">Bertolucci inizia a scrivere "Pag(ani)" ma con una correzione immediata 
                            sovrascrive su "Pag" la "N" di "Ninetta".</note>
                        dorme<lb/>
                    </l>
                    <l n="4">e Pagani 
                        <app>
                            <rdg wit="#txt-c">
                                <choice>
                                    <sic>e chiusi</sic>
                                    <corr resp="#txt-c">è chiuso</corr>
                                </choice>
                            </rdg>
                            <rdg wit="#txt-1 #txt-2">e chiusi</rdg>
                        </app>
                        <note type="critical">Il manoscritto riporta "e chiusi"; viene corretto in "è chiuso".</note>
                        <lb/>
                    </l>
                    <l n="5">E il mattino possiamo io<lb/></l>
                    <l n="6">e Ninetta<lb/></l>
                    <l n="7">Entrare da Pagani e mangiare<lb/></l>
                    <l n="8">le millefogliefresche?<lb/></l>
                </lg>
                <ab>
                    <app>
                        <rdg wit="#txt-c"><hi rend="underline">S. Giuseppe</hi></rdg>
                        <rdg wit="#txt-1 #txt-2">                    
                            <date><hi rend="underline">S. Giuseppe <del rend="overstrike" hand="#pen2">19-<retrace>3</retrace>-1930</del></hi></date></rdg>
                    </app>
                    <note type="critical">Il manoscritto riporta l'indicazione cronologica, "19-3-1930", cassata.</note>
                </ab>
