                <lb/>
                <div>
                    <lg n="1" type="stanza">
                        <l n="1">Giorno d’
                            <app>
                                <rdg wit="#txt-c">e
                                </rdg>
                                <rdg wit="#txt-1">
                                    <retrace cause="unclear">e</retrace>
                                </rdg>
                            </app>
                            state,
                            <note type="critical">La prima –e- di "estate" è rivergata.</note>
                            al tuo declinare<lb/></l>
                        <l n="2">Riluce il fieno disteso nei campi<lb/></l>
                        <l n="3">Già lieti per la music
                            <app>
                                <rdg wit="#txt-c">a
                                </rdg>
                                <rdg wit="#txt-1">
                                    <retrace cause="unclear">a</retrace>
                                </rdg>
                            </app>
                            <note type="critical">La seconda –a- di "musica" è rivergata.</note>
                            dei grilli,<lb/></l>
                        <l n="4">Stan le rose sbocciate dolci e ferme<lb/></l>
                        <l n="5">Nella luce che lentamente muor                            
                            <app>
                                <rdg wit="#txt-c">e
                                </rdg>
                                <rdg wit="#txt-1">
                                    <retrace cause="unclear">e</retrace>
                                </rdg>
                                <note type="critical">La –e- di "muore" è rivergata. cfr. AuIn15: "Nella luce che così lenta muore."</note>
                            </app>.
                            <lb/></l>
                        <l n="6">E s’ode l’usignolo cantare,<lb/></l>                           
                        <l n="7">Mesto le sere che tu sei lontana.<lb/></l>
                        <l n="8">Ma forse lo fa mesto il mio sentirti<lb/></l>
                        <l n="9">Lontana, e forse egli è felice<lb/></l>
                        <l n="10">Come quando mi sveglia, così presto,<lb/></l>
                        <l n="11">Le mattine di sabato glorioso,<lb/></l>
                        <l n="12">Al tuo ritorno da Bologna.<lb/></l>
                        <l n="13">Allora il sole fa risplendere il tuo volto<lb/></l>
                        <l n="14">Bruno sotto la tesa del panama,<lb/></l>
                        <l n="15">Caro e animato per ci                            
                            <app>
                                <rdg wit="#txt-c">ò
                                </rdg>
                                <rdg wit="#txt-1">
                                    <retrace cause="unclear">ò</retrace>
                                </rdg>
                            </app>
                            <note type="critical">La –ò- di "ciò" è rivergata.</note> 
                            che racconti,
