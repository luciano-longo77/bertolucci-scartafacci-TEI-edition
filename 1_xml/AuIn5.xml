            <div1 type="poem" xml:id="Nuvola">
               
               <head rend="center">
                  <app>
                     <rdg wit="#txt-1 #txt-2 #txt-3 #txt-4 #txt-5">
                        <hi rend="underline">A una nuvola</hi>
                     </rdg>
                     <rdg wit="#txt-c">A una nuvola</rdg>
                  </app>
                  
                  <note type="physical">
                     L'autografo è numerato in alto a destra a matita con l’arabico 5, 
                     con una mano diversa rispetto a quella dell'autografo, probabilmente dagli indicizzatori dell'Archivio</note>
                  <fw type="sig" place="margin right">c.1r</fw>
                  <lb/>
               </head>
                  
               <div2>
                  <note type="metrical">La poesia si presenta suddivisa in 3 strofe, la prima e la terza formata da due quartine, 
                     la seconda è un'unica stanza di venti versi.</note>
                 
                  <lg n="1" type="stanza">
                     <lg type="quatrain">
                        <l n="1">Nuvola d’oro<lb/></l>
                        <l n="2">Che il vento scompiglia,<lb/></l>
                        <l n="3">Oh come il
                           <app>
                              <rdg wit="#txt-1 #txt-2">tuo</rdg>
                              <rdg wit="#txt-3"><del>tuo</del><add place="above">tuo</add></rdg>
                              <rdg wit="#txt-4 #txt-5 #txt-c">mio</rdg>
                           </app>
                            destino<lb/></l>
                        <l n="4">Al                            
                           <app>
                           <rdg wit="#txt-1 #txt-2">mio</rdg>
                           <rdg wit="#txt-3"><del>mio</del><add place="above">tuo</add></rdg>
                           <rdg wit="#txt-4 #txt-5 #txt-c">tuo</rdg>
                        </app>
                           somiglia.<lb/></l>
                     </lg>
                  </lg>
                  
                  <lg n="2" type="stanza">
                     <lg type="stanza">
                        <l n="5">Leggera e solitaria<lb/></l>
                        <l n="6">
                           <app>
                              <rdg wit="#txt-1">Vaghi</rdg>
                              <rdg wit="#txt-2"><del>Vaghi</del><add> In tua ingannevol forma</add></rdg>
                              <rdg wit="#txt-3"><del>In tua ingannevol forma</del><add> Percorri</add></rdg>
                              <rdg wit="#txt-4"><del>Percorri</del><add> Vaghi</add></rdg>
                              <rdg wit="#txt-5"><del>Vaghi</del><add> Corri</add></rdg>
                              <rdg wit="#txt-c">Corri</rdg>
                           </app>
                           <lb/></l>
                        <l n="7">
                           <app>
                              <rdg wit="#txt-1">In tua mutevole forma</rdg>
                              <rdg wit="#txt-2"><del>In tua mutevole forma </del><add>Vaghi</add></rdg>
                              <rdg wit="#txt-3"><del>Vaghi</del><add>Sempre in mutevol forma</add></rdg>
                              <rdg wit="#txt-4 #txt-5 #txt-c">Sempre in mutevol forma</rdg>
                           </app>
                           <lb/></l>
                        <l n="8">Le azzurre vie dell’aria:<lb/></l>
                        <l n="9">Ora, splendente e bianca<lb/></l>
                        <l n="10">Quando la notte viene,<lb/></l>
                        <l n="11">La stanca<lb/></l>
                        <l n="12">Luna vinci in chiarore,<lb/></l>
                        <l n="13">Or fosca all’orizzonte<lb/></l>
                        <l n="14">Porti oscuri presagi,<lb/></l>
                        <l n="15">Or 
                           <app>
                           <rdg wit="#txt-1 #txt-2 #txt-3">di</rdg>
                           <rdg wit="#txt-4"><del>di</del><add place="above"> co</add></rdg>
                           <rdg wit="#txt-5 #txt-c">con</rdg>
                           </app>
                           tua lieve ombra<lb/></l>
                        <l n="16">
                           <app>                              
                              <rdg wit="#txt-1 #txt-2 #txt-3">Adorni il vasti piano <unclear>???</unclear> <unclear>???</unclear> il monte</rdg>
                              <rdg wit="#txt-4"><del>Adorni il vasti piano <unclear>???</unclear> <unclear>???</unclear> il monte</del> 
                                 <add>Proteggi dall’estate un picciol fonte.</add></rdg>
                              <rdg wit="#txt-5 #txt-c">Proteggi dall’estate un picciol fonte.</rdg>
                           </app>
                           <lb/></l>
                        <l n="17">
                           <app>
                              <rdg wit="#txt-1 #txt-2">Ti trasformi di rosata</rdg>
                              <rdg wit="#txt-3">Ti <del>trasformi</del><add place="above">muti</add>di rosata</rdg>
                              <rdg wit="#txt-4 #txt-5 #txt-c">Ti muti di rosata</rdg>
                           </app>
                           <lb/></l>
                        <l n="18">                           
                           <app>                              
                              <rdg wit="#txt-1 #txt-2">(Qual’era questa mane</rdg>
                              <rdg wit="#txt-3">(Qual’er<del>a</del><add>i</add> questa mane</rdg>
                              <rdg wit="#txt-4"><del>(Qual’eri questa mane</del><add>Tale</add> 
                              <add><del> Tale</del> (Tal eri questa mane</add></rdg>
                              <rdg wit="#txt-5 #txt-c">(Tal eri questa mane</rdg>
                        </app>
                           <lb/></l>
                        <l n="19">
                           <app>                              
                              <rdg wit="#txt-1 #txt-2 #txt-3">Nel fresco e silente tempo</rdg>
                              <rdg wit="#txt-4"><del>Nel fresco e silente tempo</del>
                                 <add> In quel silente tempo</add></rdg>
                              <rdg wit="#txt-5 #txt-c">In quel silente tempo</rdg>
                           </app>
                           <lb/></l>
